CONFIG_FREERTOS_UNICORE=y
CONFIG_ESP32S2_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S2_DEFAULT_CPU_FREQ_MHZ=240

# On the ESP32-S2, IRAM and DRAM share one 172 KB pool: the linker starts
# dram0_0_seg at ORIGIN + (_iram_end - _iram_start), so every byte of IRAM
# costs a byte of DRAM. Keeping the WiFi hot paths in IRAM costs ~19 KB of
# DRAM and overflows .bss at link time. Trading WiFi throughput for the RAM
# is the right side of that deal here -- the control link is small frequent
# packets, not bulk transfer. Not applied to the ESP32, which has room.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set